venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local configuration, credentials, and private keys
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.*

