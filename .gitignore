# Downloaded source data and regenerable caches
data/raw/*
!data/raw/.gitkeep
data/cache/

# Derived artifacts are ignored except the frozen 10k evaluation inputs.
data/processed/
!data/processed/
data/processed/*
!data/processed/day3_heldout_10000_m4v3/
data/processed/day3_heldout_10000_m4v3/*
!data/processed/day3_heldout_10000_m4v3/preflight_manifest.json
!data/processed/day3_heldout_10000_m4v3/chunks/
data/processed/day3_heldout_10000_m4v3/chunks/*
!data/processed/day3_heldout_10000_m4v3/chunks/M1_fixed_256.jsonl
!data/processed/day3_heldout_10000_m4v3/chunks/M2_fixed_510.jsonl
!data/processed/day3_heldout_10000_m4v3/chunks/M3_semantic.jsonl

# Keep the frozen 10k split manifest. Ignore any other generated split files.
data/splits/*
!data/splits/day3_heldout_10000_m4v3.json

# Preserve the completed 400-query corrected six-method held-out experiment.
results/
!results/
results/*
# The 10k split validator reads these frozen reference manifests.
!results/day3/
results/day3/*
!results/day3/experiment_manifest.json
!results/day3_corrected/
results/day3_corrected/*
!results/day3_corrected/experiment_manifest.json
!results/day3_dev_m4v3_fact_alias_fix/
results/day3_dev_m4v3_fact_alias_fix/*
!results/day3_dev_m4v3_fact_alias_fix/experiment_manifest.json
# Preserve every artifact from the completed six-method 400-query run.
!results/day3_heldout_m4v3_alias_fix/
!results/day3_heldout_m4v3_alias_fix/**
